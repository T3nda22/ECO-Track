# ==============================================================================
# ECO TRACK: GIS-Based Waste Management System
# Configuration Environment Variables
# Location: Barangay Poblacion, Minglanilla, Cebu, Philippines
# ==============================================================================

# Flask Secret Key for Session Encryption & CSRF Protection
SECRET_KEY=ecotrack-poblacion-minglanilla-capstone-key-2026-secure

# Flask Environment Mode (development / production)
FLASK_ENV=development

# Database Connection:
# Development default uses SQLite for zero-configuration local execution.
# To deploy with MySQL (XAMPP / MariaDB / Cloud MySQL), uncomment the MySQL line below:
DATABASE_URL=sqlite:///ecotrack.db
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/ecotrack_db
